interface IUniswapV2Factory {
    function createPair(
        address tokenA,
        address tokenB
    ) external returns (address pair);
}

interface IUniswapV2Router02 {
    function swapExactTokensForETHSupportingFeeOnTransferTokens(
        uint amountIn,
        uint amountOutMin,
        address[] calldata path,
        address to,
        uint deadline
    ) external;

    function swapExactETHForTokensSupportingFeeOnTransferTokens(
        uint amountIn,
        uint amountOutMin,
        address[] calldata path,
        address to,
        uint deadline
    ) external payable;

    function factory() external pure returns (address);

    function WETH() external pure returns (address);

    function addLiquidityETH(
        address token,
        uint amountTokenDesired,
        uint amountTokenMin,
        uint amountETHMin,
        address to,
        uint deadline
    )
        external
        payable
        returns (uint amountToken, uint amountETH, uint liquidity);
}

contract XPERT is ERC20, Ownable {
    using SafeMath for uint256;
    IUniswapV2Router02 public uniswapV2Router;
    address public immutable uniswapV2Pair;

    mapping(address => bool) private _isExcludedFromFee;
    mapping(address => bool) private bots;
    address payable private _marketingWallet;
    address payable private _devWallet;

    uint256 private _buyTax = 25;
    uint256 private _sellTax = 40;

    // all 3 togeter devide the tax into 60% mw / 20% dw / 20% burn
    uint256 private _marketingShare = 50; // 3 60% from tax - 20% burn
    uint256 private _devShare = 30; // 1 from 60% tax - 20% burn
    uint256 private _burnShare = 20; // 20% = 1 from 60% tax  -> tax - burn
    uint256 public launchBlock;

    string private constant _name = "SCAN XPERT";
    string private constant _symbol = "XPERT";
    uint256 public _maxTxAmount = 20_000 * (10 ** decimals());
    uint256 public _maxWalletSize = 20_000 * (10 ** decimals());
    uint256 public _swapTokensAtAmount = 0; // if tokens from fee are higher than swap out for eth

    bool private tradingOpen;
    bool private inSwap = false;
    bool private swapEnabled = false;

    event MaxTxAmountUpdated(uint _maxTxAmount);

    event SwapTokensForETH(uint256 amountIn, address[] path);

    modifier lockTheSwap() {
        inSwap = true;
        _;
        inSwap = false;
    }

    constructor() ERC20("SCAN XPERT", "XPERT") {
        IUniswapV2Router02 _uniswapV2Router = IUniswapV2Router02(0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D);//
        uniswapV2Router = _uniswapV2Router;
        uniswapV2Pair = IUniswapV2Factory(_uniswapV2Router.factory())
            .createPair(address(this), _uniswapV2Router.WETH()); 

        // set tax wallets
        _marketingWallet = payable(_msgSender());
        _devWallet = payable(_msgSender());

        // exclude from paying fees
        _isExcludedFromFee[owner()] = true;
        _isExcludedFromFee[address(this)] = true;
        _isExcludedFromFee[_marketingWallet] = true;
        _isExcludedFromFee[_devWallet] = true;
        /*
            an internal function that is only called here,
            and CANNOT be called ever again
        */
        _createSupply(owner(), 1_000_000 * (10 ** decimals()));
        emit Transfer(address(0), _msgSender(), totalSupply());
    }

    /**
     * @dev Check all requirements befor execute the TX. Invoke selling tax token on incomming sell tx.
    */
    function _transfer(
        address from,
        address to,
        uint256 amount
    ) internal override {
        require(from != address(0), "ERC20: transfer from the zero address");
        require(to != address(0), "ERC20: transfer to the zero address");
        require(amount > 0, "Transfer amount must be greater than zero");

        if (from != owner() && to != owner()) {
            //Trade start check
            if (!tradingOpen) {
                require(
                    from == owner(),
                    "This account cannot send tokens until trading is enabled"
                );
            }
            require(amount <= _maxTxAmount, "Exceeds the _maxTxAmount.");
            require(!bots[from] && !bots[to], "Blacklisted address");

            if (
                block.number <= launchBlock + 1 &&
                from == uniswapV2Pair &&
                to != address(uniswapV2Router) &&
                to != address(this)
            ) {
                bots[to] = true;
            }

            if (to != uniswapV2Pair) {
                require(
                    balanceOf(to) + amount <= _maxWalletSize,
                    "Exceeds the maxWalletSize."
                );
            }

            uint256 contractTokenBalance = balanceOf(address(this));
            bool canSwap = contractTokenBalance >= _swapTokensAtAmount;

            if (contractTokenBalance >= _maxTxAmount) {
                contractTokenBalance = _maxTxAmount;
            }

            if (
                canSwap &&
                !inSwap &&
                from != uniswapV2Pair &&
                swapEnabled &&
                !_isExcludedFromFee[from] &&
                !_isExcludedFromFee[to]
            ) {
                uint256 burn = 0;
                if(_burnShare > 0) {
                    burn = contractTokenBalance.mul(_burnShare).div(100);
                    super._burn(address(this), burn);
                }
                swapTokensForEth(contractTokenBalance.sub(burn));
                uint256 contractETHBalance = address(this).balance;
                if (contractETHBalance > 0 ) {
                    sendETHToFee(address(this).balance);
                }
            }
        }

        bool takeFee = true;

        //Transfer Tokens
        if (
            (_isExcludedFromFee[from] || _isExcludedFromFee[to]) ||
            (from != uniswapV2Pair && to != uniswapV2Pair)
        ) {
            takeFee = false;
        } else {
            takeFee = true;
        }

        _tokenTransfer(from, to, amount, takeFee);
    }

    /**
     * @dev Take fee if needed and transfer to target addresses.
    */
    function _tokenTransfer(
        address from,
        address to,
        uint256 amount,
        bool takeFee
    ) private {
        if (takeFee) {
            uint256 fees;
            // get tax in eth for buy or token for sell
            fees = amount
                .mul((from == uniswapV2Pair) ? _buyTax : _sellTax)
                .div(100);

            // remove tax (fees+burn) from amount
            amount = amount.sub(fees);

            // transfer fee
            super._transfer(from, address(this), fees);

        }
        // final transfer of left amount
        super._transfer(from, to, amount);
    }

    /**
     * @dev sell the specified amount of token for ETH.
    */
    function swapTokensForEth(uint256 tokenAmount) private lockTheSwap {
        address[] memory path = new address[](2);
        path[0] = address(this);
        path[1] = uniswapV2Router.WETH();
        _approve(address(this), address(uniswapV2Router), tokenAmount);
        uniswapV2Router.swapExactTokensForETHSupportingFeeOnTransferTokens(
            tokenAmount,
            0,
            path,
            address(this),
            block.timestamp
        );
        emit SwapTokensForETH(tokenAmount, path);
    }

    /**
     * @dev Set max tx amount and max wallet size to `total supply`.
     *
     * Emits a {MaxTxAmountUpdated} event with `total supply`.
     */
    function removeLimits() external onlyOwner {
        _maxTxAmount = totalSupply();
        _maxWalletSize = totalSupply();
        emit MaxTxAmountUpdated(totalSupply());
    }

    /**
     * @dev Send eth to MW and DW.
     */
    function sendETHToFee(uint256 amount) private {
        require(amount > 0, "No ETH available for mw and dw!");
        _marketingWallet.transfer(amount.mul(_marketingShare).div(100));
        _devWallet.transfer(amount.mul(_devShare).div(100));
    }

    /**
     * @dev Add addresses to bot list.
     */
    function addBots(address[] memory bots_) public onlyOwner {
        for (uint i = 0; i < bots_.length; i++) {
            bots[bots_[i]] = true;
        }
    }

    /**
     * @dev Removes addresses from bot list.
     */
    function delBots(address[] memory notbot) public onlyOwner {
        for (uint i = 0; i < notbot.length; i++) {
            bots[notbot[i]] = false;
        }
    }

    /**
     * @dev Creates the uniswap pair and opens the trading.
     */
    function openTrading() external onlyOwner {
        require(!tradingOpen, "trading is already open");
        swapEnabled = true;
        tradingOpen = true;
        launchBlock = block.number;
    }

    receive() external payable {}

    /**
     * @dev Manual method to swap token to ETH.
    */
    function manualswap() external onlyOwner {
        swapTokensForEth(balanceOf(address(this)));
    }

    /**
     * @dev Manual method to send ETH to mw and dw.
    */
    function manualsend() external onlyOwner {
        sendETHToFee(address(this).balance);
    }

    /**
     * @dev change the share ratio betwee marketing, dev and burn.
    */
    function setShare(uint256 marketingShare, uint256 devShare, uint256 burnShare) public onlyOwner {
        _marketingShare = marketingShare;
        _devShare = devShare;
        _burnShare = burnShare;
    }

    /**
     * @dev change the buy and sell tax values.
    */
    function setTax(uint256 buyTax, uint256 sellTax) public onlyOwner {
        _buyTax = buyTax;
        _sellTax = sellTax;
    }

    /**
     * @dev set a new marketing wallet.
    */
    function setMarketingWallet(address payable marketingWallet) public onlyOwner {
        _marketingWallet = marketingWallet;
    }

    /**
     * @dev set a new dev wallet.
    */	
    function setDevWallet(address payable devWallet) public onlyOwner {
        _devWallet = devWallet;
    }

    /**
     * @dev Function to recover any ETH sent to Contract by Mistake.
    */	
    function recoverETHFromContract(uint256 weiAmount) external onlyOwner{
        require(address(this).balance >= weiAmount, "insufficient ETH balance");
        payable(owner()).transfer(weiAmount);
    }
       
    /**
     * @dev Function to recover any ERC20 Tokens sent to Contract by Mistake.
    */
    function recoverAnyERC20TokensFromContract(address _tokenAddr, address _to, uint _amount) public onlyOwner {
        IERC20(_tokenAddr).transfer(_to, _amount);
    }
}