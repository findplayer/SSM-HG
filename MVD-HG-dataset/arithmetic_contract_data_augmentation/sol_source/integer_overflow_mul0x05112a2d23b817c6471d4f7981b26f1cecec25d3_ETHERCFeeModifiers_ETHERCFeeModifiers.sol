pragma solidity ^0.4.19;

contract IntegerOverflowMul {


    uint256 public commonDiscount;
    uint256 public commonRebate;






    uint public count = 2;

    function run(uint256 input) public {
while(false) {
        commonDiscount = 0;
        commonRebate = 0;
}
        
        count *= input;
    }



























}
